# Copy this file to .env and fill in your fusion node's real address.

# Address of the fusion node (server) this client connects to.
FUSION_NODE_HOST=localhost
FUSION_NODE_PORT=5000

# UUID this ASM sends as the SapientMessage destination_id -- the fusion
# node's own node id, not this node's. Ask your fusion node operator for it.
FUSION_NODE_DESTINATION_ID=00000000-0000-0000-0000-000000000000

# Set FUSION_NODE_TLS_CA_CERT to switch main.py from plain TCP to TLS (see
# _build_socket_provider()). Client cert/key are optional -- only needed if
# your fusion node requires mutual TLS.
#
# Each of these takes a file path or inline PEM text.

# 1. PEM files:
# FUSION_NODE_TLS_CA_CERT=tls/ca.pem
# FUSION_NODE_TLS_CLIENT_CERT=tls/cert.pem
# FUSION_NODE_TLS_CLIENT_KEY=tls/key.pem

# 2. DER files -- same thing, the encoding is detected from the content, so
#    the extension doesn't matter. Referenced by path because a .env file
#    holds text and DER is binary; in code you can pass DER bytes directly
#    to build_client_ssl_context():
# FUSION_NODE_TLS_CA_CERT=tls/ca.der
# FUSION_NODE_TLS_CLIENT_CERT=tls/cert.der
# FUSION_NODE_TLS_CLIENT_KEY=tls/key.der

# 3. Inline PEM -- take your .pem file as-is, replace its line breaks with
#    \n, and wrap the whole value in double quotes as shown below. The
#    quotes must be double: inside single quotes the \n is left as a literal
#    backslash-n and the certificate fails to load.
# FUSION_NODE_TLS_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIDazCCAlOgAwIBAgIUZ0m1...\n-----END CERTIFICATE-----\n"
# FUSION_NODE_TLS_CLIENT_CERT="-----BEGIN CERTIFICATE-----\nMIIDXTCCAkWgAwIBAgIJAKL0...\n-----END CERTIFICATE-----\n"
# FUSION_NODE_TLS_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0B...\n-----END PRIVATE KEY-----\n"

# Connection liveness tuning. Values below are SocketClient's own built-in
# defaults -- tune for your network. What each one controls is documented in
# this directory's README.md, section "Timeouts, explained".
SOCKET_PROBE_TIMEOUT_SECONDS=2
SOCKET_INITIAL_RECONNECT_DELAY_SECONDS=1
SOCKET_WATCHDOG_INTERVAL_SECONDS=10

LOG_LEVEL=INFO